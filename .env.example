# =====================================================================
# Happy Shopping OMS + CRM — environment variables
# Production URL: https://happyomnichannel.vercel.app  (Vercel project: happyomnichannel)
# ---------------------------------------------------------------------
# ⚠️  The current MOCKUP does not read any of these variables.
#     All data is generated in src/lib/mock-data.ts, so the app deploys
#     and runs on Vercel with NO env vars set.
#
# This file is a template for the real system (phase 2).
#   Local:  cp .env.example .env.local   (never commit .env.local)
#   Vercel: Project → Settings → Environment Variables
#           or `vercel env add <NAME>` / `vercel env pull .env.local`
#
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only — keep secrets WITHOUT that prefix.
# =====================================================================

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Happy Shopping OMS"
NEXT_PUBLIC_APP_URL=https://happyomnichannel.vercel.app
# Set to "false" once real channel APIs are connected
NEXT_PUBLIC_DEMO_MODE=true
# Timezone: do NOT set TZ (reserved on Vercel). Dates are formatted with timeZone "Asia/Bangkok" in src/lib/format.ts

# ---------- Database (Vercel Marketplace: Neon Postgres / Supabase) ----------
DATABASE_URL=
# Cache / queue for webhooks & stock sync (Vercel Marketplace: Upstash Redis)
REDIS_URL=

# ---------- Auth (staff login) ----------
AUTH_SECRET=                      # generate: openssl rand -base64 32
AUTH_URL=https://happyomnichannel.vercel.app

# ---------- File storage (payment slips, return evidence, product images) ----------
BLOB_READ_WRITE_TOKEN=            # Vercel Blob

# ---------- Shopee Open Platform ----------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=https://happyomnichannel.vercel.app/api/channels/shopee/callback

# ---------- Lazada Open Platform ----------
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL=https://happyomnichannel.vercel.app/api/channels/lazada/callback

# ---------- TikTok Shop Partner Center ----------
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_REDIRECT_URL=https://happyomnichannel.vercel.app/api/channels/tiktok/callback

# ---------- LINE Official Account (Messaging API) ----------
# Webhook URL in LINE console: https://happyomnichannel.vercel.app/api/webhooks/line
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- Meta (Facebook Page + Instagram Messaging) ----------
# Webhook URL in Meta app: https://happyomnichannel.vercel.app/api/webhooks/meta
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=        # any random string; must match Meta webhook settings

# ---------- Shipping carriers (optional, for non-marketplace orders) ----------
# FLASH_EXPRESS_MCH_ID=
# FLASH_EXPRESS_SECRET=
# KERRY_EXPRESS_API_KEY=
# JT_EXPRESS_API_KEY=
